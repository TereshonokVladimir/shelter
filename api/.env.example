DATABASE_URL="file:./dev.db"
JWT_SECRET="last-shelter-dev-secret-change-me"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Solo QA bots (default on when NODE_ENV !== production). Set false for prod.
ENABLE_MOCK_BOTS=true
# Content admin panel (/admin) — send as X-Admin-Token
ADMIN_TOKEN="dev-admin-token-change-me"
